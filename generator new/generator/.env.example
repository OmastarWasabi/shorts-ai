# Переключатели команды generate; отсутствующий флаг означает true.
GENERATE_VOICE=true
GENERATE_IMAGES=true

# Вставьте свои ключи. Пустые значения не подходят для новых запросов.
FISH_API_KEY=
OPENAI_API_KEY=

FISH_REFERENCE_ID=8336207c3431432cb60e8851e78ba437
FISH_MODEL=s2.1-pro-free

# Сохранены настройки исходного проекта; доступность модели зависит от аккаунта.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=low

# FFMPEG_BIN задаётся в окружении запуска, а не в этом файле.
